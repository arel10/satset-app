# ==============================================================================
# SatSet Laundry — PRODUCTION Environment Configuration
# ==============================================================================
# INSTRUKSI:
# 1. Salin file ini ke .env.production di root folder project
#    cp .env.production.example .env.production
# 2. Ganti SEMUA nilai placeholder (yang bertanda "GANTI_INI") dengan nilai aman
# 3. Pastikan file .env.production TIDAK di-commit ke Git
# ==============================================================================

# Aplikasi
APP_NAME=SatSet
APP_ENV=production
APP_TIMEZONE=Asia/Jakarta

# Database MySQL 8
# ⚠ GANTI password di bawah dengan password yang kuat dan unik!
DB_NAME=satset
DB_USER=satset
DB_PASSWORD=GANTI_INI_dengan_password_kuat_minimal_20_karakter
DB_ROOT_PASSWORD=GANTI_INI_dengan_root_password_kuat_minimal_20_karakter

# Port akses dari browser
# Port 80 biasanya sudah dipakai Nginx/Apache bawaan panel, gunakan port lain
FRONTEND_PORT=3000

# Keamanan & Autentikasi JWT
# ⚠ WAJIB diganti! Hasilkan secret acak yang kuat:
#    openssl rand -hex 32
JWT_ACCESS_SECRET=GANTI_INI_jalankan_openssl_rand_hex_32
JWT_REFRESH_SECRET=GANTI_INI_jalankan_openssl_rand_hex_32_lagi
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Integrasi Gemini AI (Khusus Role Owner)
# Kosongkan jika belum menggunakan AI Assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Batasan Penggunaan AI
AI_MAX_TOOL_CALLS=5
AI_DAILY_LIMIT_PER_USER=30
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_QUESTION_LENGTH=2000

# Rate Limiting Login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# CORS — URL publik frontend (tanpa trailing slash)
# Ganti dengan IP atau domain VPS kamu
FRONTEND_URL=http://20.41.112.76:3000

# Database Auto Migration
# Set ke true hanya pada deploy pertama, lalu ubah ke false
AUTO_MIGRATE=true

# Frontend Metadata
VITE_APP_NAME="SatSet Laundry"
VITE_APP_DESCRIPTION="Sistem Manajemen Laundry & POS"
VITE_APP_TIMEZONE="Asia/Jakarta"
VITE_APP_DEFAULT_LOCALE="id-ID"
VITE_APP_CURRENCY="IDR"
