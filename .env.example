# ==========================================
# SatSet Environment Configuration Template
# Salin ke .env untuk konfigurasi lokal: cp .env.example .env
# ==========================================

# Application
APP_ENV=development
APP_NAME=satset
PORT=8080

# Database (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_USER=satset
DB_PASSWORD=satset_secret
DB_NAME=satset_db
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Cache & Message Broker (Redis 7)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Object Storage (MinIO / S3)
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
S3_BUCKET=satset-assets
S3_USE_SSL=false

# Authentication & Security (placeholder for Sprint 1)
JWT_SECRET=replace-with-a-secure-random-32-byte-secret
JWT_EXPIRATION_HOURS=24

# AI Service (Google Gemini via Google AI Studio)
# Catatan: API key hanya di backend, frontend tidak pernah mengakses ini langsung
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Frontend Web Configuration
NEXT_PUBLIC_APP_NAME=SatSet
NEXT_PUBLIC_API_URL=http://localhost:8080
