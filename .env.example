# ==============================================================================
# SatSet Laundry - Docker Compose Environment Configuration
# ==============================================================================
# Salin file ini menjadi .env di root folder sebelum menjalankan docker compose

# Aplikasi
APP_NAME=SatSet
APP_ENV=production
APP_TIMEZONE=Asia/Jakarta

# Database MySQL 8
DB_PORT=3306
DB_NAME=satset
DB_USER=satset
DB_PASSWORD=satset_secret_change_me
DB_ROOT_PASSWORD=root_secret_change_me

# Port Services
BACKEND_PORT=8080
FRONTEND_PORT=3000

# Keamanan & Autentikasi JWT
# Hasilkan secret acak yang kuat untuk produksi: openssl rand -hex 32
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_characters
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Integrasi Gemini AI (Khusus Role Owner)
# Kosongkan jika belum menggunakan AI Assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Batasan Penggunaan AI
AI_MAX_TOOL_CALLS=5
AI_DAILY_LIMIT_PER_USER=30
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_QUESTION_LENGTH=2000

# Rate Limiting Login
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# CORS (Frontend URL)
FRONTEND_URL=http://localhost:3000

# Database Auto Migration (GORM)
AUTO_MIGRATE=true

# Frontend Metadata
VITE_APP_NAME="SatSet Laundry"
VITE_APP_DESCRIPTION="Sistem Manajemen Laundry & POS"
VITE_APP_TIMEZONE="Asia/Jakarta"
VITE_APP_DEFAULT_LOCALE="id-ID"
VITE_APP_CURRENCY="IDR"
