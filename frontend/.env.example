# SatSet Frontend Environment Configuration
# Salin file ini menjadi .env untuk menyesuaikan konfigurasi lokal

# URL Backend untuk Vite dev proxy (hanya aktif saat npm run dev)
VITE_BACKEND_URL=http://localhost:8080

# Base URL endpoint API frontend
# Gunakan '/api' bila menggunakan Vite proxy atau reverse proxy Nginx.
# Gunakan full URL (misal: 'http://localhost:8080/api') bila memanggil langsung lintas domain/port.
VITE_API_BASE_URL=/api

# Informasi Aplikasi
VITE_APP_NAME=SatSet Laundry
VITE_APP_DESCRIPTION=Sistem Manajemen Laundry & POS
VITE_APP_TIMEZONE=Asia/Jakarta
VITE_APP_DEFAULT_LOCALE=id-ID
VITE_APP_CURRENCY=IDR
