# SatSet - Aplikasi Manajemen Laundry
# Copy file ini menjadi .env dan isi nilai yang sesuai

# Application
APP_NAME=SatSet
APP_ENV=development
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta

# Database (MySQL 8)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=satset

# Authentication (JWT)
# Generate secret yang kuat untuk produksi: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_secure_random_secret_for_access_token
JWT_REFRESH_SECRET=replace_with_secure_random_secret_for_refresh_token
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# AI Limits
AI_MAX_TOOL_CALLS=5
AI_DAILY_LIMIT_PER_USER=30
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_QUESTION_LENGTH=2000

# Rate Limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# CORS
FRONTEND_URL=http://localhost:3000

# Auto Migrate (hanya untuk development)
AUTO_MIGRATE=true
