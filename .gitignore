# SatSet App .gitignore

# Environment variables
.env
.env.*
!.env.example
!.env.production.example

# Go build artifacts
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
/backend/bin/
/backend/main
/backend/main.exe

# Node / Frontend artifacts
node_modules/
dist/
build/
.next/
out/
.nuxt/
.cache/

# Uploads directory
/backend/uploads/*
!/backend/uploads/.gitkeep
/uploads/*
!/uploads/.gitkeep

# Logs and databases
*.log
*.sqlite
*.sqlite3
*.db

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor folders
.idea/
.vscode/
*.swp
*.swo
